# Copy to .env.local only for local development; never commit real secrets.
# Demo data lives in .local/planner.json and is NOT synced to GitHub.
# Demo mode is always disabled in production.
LOCAL_DEMO=false

# Production URL, without a trailing path.
APP_URL=https://your-project.vercel.app
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Your immutable numeric GitHub user ID, not username.
GITHUB_ALLOWED_USER_ID=
# Generate at least 32 random characters; store only in hosting settings.
SESSION_SECRET=
GITHUB_OWNER=changmin0722zv-hash
GITHUB_REPO=teacher-s-helper
GITHUB_DATA_BRANCH=main

# Optional: NEIS school events. Server-only; set on Vercel Production and redeploy.
NEIS_API_KEY=
